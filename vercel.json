{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "gifts.3mtrading.ca" }],
      "dest": "/claim/index.html"
    },
    { "handle": "filesystem" }
  ]
}
